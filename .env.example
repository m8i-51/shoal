# ================================================================
# LLM Provider
# ================================================================
# LLM_PROVIDER に使いたいプロバイダ名を設定してください。
# LLM_BASE_URL / LLM_MODEL は省略時にプロバイダのデフォルト値が使われます。

# --- Anthropic (default) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-haiku-4-5-20251001   # 省略可

# --- Claude CLI (Claude Code subscription / login) ---
# Uses the official Claude Code CLI login — shoal never reads OAuth tokens.
# Prerequisite: install Claude Code, then either:
#   npm run auth:claude
#   or: claude auth login  &&  set LLM_PROVIDER=claude-cli below
# If ANTHROPIC_API_KEY is also set, Claude Code may bill the API instead of your subscription — unset it to use Pro/Max quota.
# LLM_PROVIDER=claude-cli
# LLM_MODEL=claude-sonnet-4-6           # 省略可
# ANTHROPIC_API_KEY=                    # leave unset for subscription auth

# --- OpenAI ---
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini                 # 省略可（デフォルト: gpt-4o-mini）

# --- OpenAI Codex (ChatGPT サブスク OAuth) ---
# 事前に認証が必要: npm run auth:codex
# LLM_PROVIDER=codex
# LLM_MODEL=gpt-5.1-codex-mini          # 省略可

# --- Amazon Bedrock ---
# Do NOT set empty AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY= lines.
# An empty value overrides the default credential chain and auth will fail.
# Leave them unset to use ~/.aws/credentials, a named profile, SSO cache, or an instance role.
# Short-lived `aws sso login` is often rejected when the default profile already has
# long-lived keys — in that case, use the existing keys instead of forcing a new login.
# LLM_PROVIDER=bedrock
# AWS_ACCESS_KEY_ID=AKIA...          # omit to use the default credential chain
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=ap-northeast-1
# LLM_MODEL=jp.anthropic.claude-sonnet-4-5-20250929-v1:0
#
# Regional / geographic inference profile examples (not every generation is available
# for in-region invoke or every geo profile — pick a generation that exists in your region):
#   US:    us.anthropic.claude-sonnet-4-5-20250929-v1:0          AWS_REGION=us-east-1
#   EU:    eu.anthropic.claude-sonnet-4-5-20250929-v1:0          AWS_REGION=eu-central-1
#   APAC:  apac.anthropic.claude-sonnet-4-5-20250929-v1:0        AWS_REGION=ap-northeast-1
#   Japan: jp.anthropic.claude-sonnet-4-5-20250929-v1:0          AWS_REGION=ap-northeast-1
#          jp.anthropic.claude-haiku-4-5-20251001-v1:0
#          jp.anthropic.claude-sonnet-4-6
# Foundation model IDs (on-demand, when the region offers them):
#   anthropic.claude-3-5-haiku-20241022-v1:0

# --- Groq (無料枠あり・高速) ---
# https://console.groq.com でキー取得
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile     # 省略可

# --- Google Gemini (無料枠あり) ---
# https://aistudio.google.com でキー取得
# LLM_PROVIDER=gemini
# LLM_API_KEY=AIzaSy...
# LLM_MODEL=gemini-2.0-flash            # 省略可

# --- Ollama (ローカル / クラウド) ---
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2                    # 省略可
# LLM_API_KEY=                          # クラウドモデルの場合は API キーを設定
# LLM_BASE_URL=http://localhost:11434/v1 # 省略可（ローカルのデフォルト値）

# --- LM Studio (ローカル) ---
# LLM_PROVIDER=lm-studio
# LLM_MODEL=<LM Studio に表示されるモデル名>
# LLM_BASE_URL=http://localhost:1234/v1  # 省略可（デフォルト値）

# --- OpenRouter (多数のモデルにアクセス可) ---
# https://openrouter.ai でキー取得
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-...
# LLM_MODEL=google/gemini-flash-1.5     # 省略可 / モデル一覧: openrouter.ai/models

# --- その他 OpenAI 互換エンドポイント ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://your-endpoint/v1
# LLM_API_KEY=your-key
# LLM_MODEL=your-model

# ================================================================
# Target app
# ================================================================

TARGET=none             # example | none | カスタムターゲット名
BASE_URL=http://localhost:3000

# ================================================================
# Issue Tracker (optional)
# ================================================================
# カンマ区切りで複数のトラッカーを同時に有効化できます。
# ISSUE_TRACKERS が未設定で GITHUB_TOKEN/GITHUB_REPO がある場合は github が自動で有効になります。

# ISSUE_TRACKERS=github,backlog

# --- GitHub Issues ---
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# --- Jira ---
# JIRA_BASE_URL=https://yourcompany.atlassian.net
# JIRA_EMAIL=user@example.com
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=PROJ

# --- Notion ---
# NOTION_API_KEY=
# NOTION_DATABASE_ID=
# ※ Notion のデータベースには Name (title) / Labels (multi_select) / Status (select) プロパティが必要です

# --- Backlog ---
# BACKLOG_SPACE=yourspace
# BACKLOG_API_KEY=
# BACKLOG_PROJECT_ID=12345

# --- Asana ---
# ASANA_ACCESS_TOKEN=
# ASANA_PROJECT_ID=

# ================================================================
# Run config
# ================================================================

MAX_EXPLORERS=4
MAX_BROWSERS=2
# Threshold agents probe input/business/experience boundaries (0 disables).
# Cached product specs without thresholdCandidates need REFRESH_SPEC=1.
MAX_THRESHOLDS=1

# Safety mode — how much agents are allowed to write to the app
#   read-only : no writes at all (mutation requests are blocked at the network layer)
#   safe      : test data OK, but irreversible actions (delete / pay / send) are avoided (default)
#   full      : no restrictions — use only against disposable environments
# SHOAL_MODE=safe

# Playwright trace — ブラウザエージェントのセッションを logs/traces/ に記録します（0 で無効化）
# 各 finding から `npx playwright show-trace <zip>` でエージェントの操作を再生できます
# SHOAL_TRACE=1

# 1 に設定するとキャッシュ済みの product spec を無視し product discovery を再実行します
# REFRESH_SPEC=1

# Spend cap for one run, in estimated USD. Once reached, no further LLM call
# starts and the remaining lanes are skipped — findings already collected are
# still saved and reported. Turn budgets bound each agent; this bounds the run.
# SHOAL_MAX_USD=5

# Agent turn budgets and dispatch (defaults shown)
# SHOAL_BROWSER_ITERATIONS=12
# SHOAL_THRESHOLD_ITERATIONS=12
# SHOAL_EXPLORER_CONCURRENCY=2
# SHOAL_VIEWPORT=1024x640

# ================================================================
# Dashboard (shoal serve)
# ================================================================

# Bind address. The default is loopback: only this machine can reach the
# dashboard, and no token is needed. The dashboard can start runs against any
# URL this machine can reach, so treat exposing it as a deliberate act.
# SHOAL_HOST=127.0.0.1

# Setting SHOAL_HOST to anything but loopback is REFUSED unless this is set to 1.
# The listener is plain HTTP, so the token and session cookie would cross the
# network in cleartext. Set this only when TLS is terminated in front of shoal
# (a reverse proxy), or when you accept cleartext on a trusted network.
# An SSH tunnel — ssh -L 4000:localhost:4000 host — needs neither variable.
# SHOAL_ALLOW_INSECURE=1

# Required whenever SHOAL_HOST is not loopback. If unset, shoal generates one
# and prints it (with a ready-made ?token=... URL) at startup. At least 16 chars.
# SHOAL_TOKEN=

# Persona templates (optional)
# Path to a local YAML/JSON file, or an npm package name.
# If omitted, shoal auto-discovers personas.yaml / personas.yml / personas.json in the project root.
# SHOAL_PERSONAS=./personas.yaml
# SHOAL_PERSONAS=shoal-personas-ecommerce
