{
  "name": "@m8i-51/shoal",
  "version": "0.2.0",
  "type": "module",
  "description": "Multi-agent web exploration framework \u2014 finds bugs, UX issues, and missing features by running AI agents against your app",
  "license": "MIT",
  "author": "m8i-51",
  "homepage": "https://github.com/m8i-51/shoal#readme",
  "bugs": {
    "url": "https://github.com/m8i-51/shoal/issues"
  },
  "keywords": [
    "ai-agents",
    "browser-automation",
    "llm",
    "multi-agent",
    "playwright",
    "qa",
    "test-automation",
    "ux-testing"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/m8i-51/shoal"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "fast-uri": "^3.1.7"
  },
  "bin": {
    "shoal": "./bin/shoal.js"
  },
  "files": [
    "bin/",
    "framework/",
    "targets/",
    "server/",
    "web/dist/",
    "run.ts",
    "triage-only.ts",
    "diff.ts",
    ".env.example",
    ".github/workflows/shoal-weekly.example.yml",
    "!**/__tests__/**"
  ],
  "scripts": {
    "prepublishOnly": "npm run build:web",
    "start": "tsx run.ts",
    "triage": "tsx triage-only.ts",
    "serve": "tsx server/index.ts",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch --no-cache server/index.ts",
    "dev:web": "vite web",
    "build:web": "vite build web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "auth:codex": "tsx scripts/auth-codex.ts",
    "auth:claude": "tsx scripts/auth-claude.ts",
    "bench": "tsx bench/index.ts",
    "bench:forms": "BENCH_VARIANT=forms tsx bench/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.33.3",
    "@anthropic-ai/claude-agent-sdk": "^0.3.247",
    "@anthropic-ai/sdk": "^0.122.0",
    "@clack/prompts": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axe-core": "^4.12.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.0",
    "openai": "^7.8.0",
    "playwright": "^1.59.1",
    "tsx": "^4.22.4",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.6",
    "concurrently": "^10.0.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "i18next": "^26.0.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.4",
    "react-router-dom": "^7.14.1",
    "supertest": "^7.2.2",
    "typescript": "^5",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.5"
  }
}
